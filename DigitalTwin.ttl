# baseURI: https://ontology.tno.nl/logistics/federated/DigitalTwin
# prefix: DigitalTwin

@prefix : <https://ontology.tno.nl/logistics/federated/DigitalTwin#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix LegalPerson: <https://ontology.tno.nl/logistics/federated/LegalPerson#> .

<https://ontology.tno.nl/logistics/federated/DigitalTwin>
  a owl:Ontology ;
  dc:creator "Dena Tahvildari, Cornelis Bouter, Maaike Burghoorn, Theodor Chirvasuta" ;
  dcterms:created "2020-07-17"^^xsd:date ;
  dcterms:description "This is DigitalTwin ontology. It contains classes, attributes and relationships about logistics physical real world object. The usecase is two: 1. it is part of federated logistics ontology architecture that is referenced and used by Event module. 2. It will be evolved (extended) to cover digital Twin technologies requirements. " ;
  dcterms:isRequiredBy <https://ontology.tno.nl/logistics/federated/Event> ;
  dcterms:issued "2026-04-05"^^xsd:date ;
  dcterms:language "en" ;
  owl:versionIRI <https://ontology.tno.nl/logistics/federated/DigitalTwin-v0.1> ;
.
# ------------ CLASSES ------------ 
:Airplane
  a owl:Class ;
  rdfs:comment "Transport means by air." ;
  rdfs:label "Airplane" ;
  rdfs:subClassOf :TransportMeans ;
.
:Barge
  a owl:Class ;
  rdfs:comment "Vessel used for transporting cargo on inland waterways." ;
  rdfs:label "Barge" ;
  rdfs:subClassOf :Vessel ;
.
:BulkEquipment
  a owl:Class ;
  rdfs:comment "Objects for loose, unpackaged dry solids carried in volume. To be associated to a goods object with either Rec 21 codes: VY (powders), VR (grains), VO (nodules), VS (scrap), OT (octabin), FX, JB, DK–DM, WN–WT, WV–WZ, ZA, ZC, ZD, ZF, ZL, ZM, ZS, ZT, ZU" ;
  rdfs:label "Bulk Equipment" ;
  rdfs:subClassOf :Equipment ;
.
:BulkGoods
  a owl:Class ;
  rdfs:comment "Goods in bulk form. Rec 21 codes: VY (powders), VR (grains), VO (nodules), VS (scrap), OT (octabin), FX, JB, DK–DM, WN–WT, WV–WZ, ZA, ZC, ZD, ZF, ZL, ZM, ZS, ZT, ZU" ;
  rdfs:label "Liquid Goods" ;
  rdfs:subClassOf :Goods ;
.
:Document
  a owl:Class ;
  rdfs:comment "A legal document in event and business transactions." ;
  rdfs:label "Document" ;
  rdfs:subClassOf :LogisticsObject ;
.
:Equipment
  a owl:Class ;
  rdfs:comment "Any asset used to facilitate transport and handling of cargo." ;
  rdfs:label "Transport Equipment" ;
  rdfs:subClassOf :LogisticsObject ;
.
:GasEquipment
  a owl:Class ;
  rdfs:comment "Objects designed to contain compressed or liquefied gases under pressure. To be associated to a goods object with either Rec 21 codes: CY, GB, AE, VG, VQ, WG, WH, WJ, ZG, ZH, ZN, ZP" ;
  rdfs:label "Gas Equipment" ;
  rdfs:subClassOf :Equipment ;
.
:GaseousGoods
  a owl:Class ;
  rdfs:comment "Goods in gas form. Rec 21 codes: CY, GB, AE, VG, VQ, WG, WH, WJ, ZG, ZH, ZN, ZP" ;
  rdfs:label "Liquid Goods" ;
  rdfs:subClassOf :Goods ;
.
:Goods
  a owl:Class ;
  rdfs:comment "Cargo to be carried by a transport means, requiring an equipment" ;
  rdfs:subClassOf :LogisticsObject ;
.
:LiquidEquipment
  a owl:Class ;
  rdfs:comment "Objects designed to retain and carry liquids. To be associated to a goods object with either Rec 21 codes: VL, BW, BO, BQ, BS, BV, CO, CP, DJ, DP, FL, CI, JG, VA, BA, DR, QA–QG, JC, JY, QK–QN, TG, TK, TY, FE, FB, WK–WM, ZJ, ZK, ZQ, ZR" ;
  rdfs:label "Liquid Equipment" ;
  rdfs:subClassOf :Equipment ;
.
:LiquidGoods
  a owl:Class ;
  rdfs:comment "Goods in liquid form. To be associated to a goods object with either Rec 21 codes: VL, BW, BO, BQ, BS, BV, CO, CP, DJ, DP, FL, CI, JG, VA, BA, DR, QA–QG, JC, JY, QK–QN, TG, TK, TY, FE, FB, WK–WM, ZJ, ZK, ZQ, ZR" ;
  rdfs:label "Liquid Goods" ;
  rdfs:subClassOf :Goods ;
.
:Locomotive
  a owl:Class ;
  rdfs:comment "Any traction for a train composed of one or more wagons." ;
  rdfs:label "Locomotive" ;
  rdfs:subClassOf :Train ;
.
:LogisticsObject
  a owl:Class ;
  rdfs:comment "Logistics object represents any kind of physical object that can be loaded on a transport means - The usual goods, container, package, trailer, bulk, but also other transport means (i.e., trains, trucks, airplane, barge, vessel)" ;
  rdfs:subClassOf owl:Thing ;
.
:Package
  a owl:Class ;
  rdfs:label "Package" ;
  rdfs:subClassOf :LogisticsObject ;
.
:PiecesEquipment
  a owl:Class ;
  rdfs:label "Pieces Equipment" ;
  rdfs:comment "Objects that hold, group or unitise countable, individually handled solid goods. To be associated to a goods object with either Rec 21 codes: PP, PK, PA, PC, BX, CS, CT, CR, SC, FC, BK, PU, PX, OA–OF, RK, RJ, EN, SW, VP, CN, ME, plus the bundle family (BR, RD, PI, PN, IN, GI, BZ, RZ, PV) and unpackaged NE, NF, NG, UN" ;
  rdfs:subClassOf :Equipment ;
.
:PiecesGoods
  a owl:Class ;
  rdfs:label "Pieces Goods" ;
  rdfs:comment "Goods in individually handled solid form, discrete, countable, dimensioned units. Rec 21 codes: PP, PK, PA, PC, BX, CS, CT, CR, SC, FC, BK, PU, PX, OA–OF, RK, RJ, EN, SW, VP, CN, ME, plus the bundle family (BR, RD, PI, PN, IN, GI, BZ, RZ, PV) and unpackaged NE, NF, NG, UN" ;
  rdfs:subClassOf :Goods ;
.
:RailwayWagon
  a owl:Class ;
  rdfs:comment "Unpowered railway vehicles that are used for the transportation of cargo." ;
  rdfs:label "Railway Wagon" ;
  rdfs:subClassOf :Equipment ;
.
:Seal
  a owl:Class ;
  rdfs:comment "Additional support Logistic Object that can only be introduced for an Equipment / Goods" ;
  rdfs:label "Seal" ;
.
:Trailer
  a owl:Class ;
  rdfs:comment "Unpowered road vehicles that are used for the transportation of cargo." ;
  rdfs:label "Trailer" ;
  rdfs:subClassOf :Equipment ;
.
:Train
  a owl:Class ;
  rdfs:label "Train" ;
  rdfs:subClassOf :TransportMeans ;
.
:TransportMeans
  a owl:Class ;
  rdfs:comment """These are the vehicles that transport the cargo, such as trucks, vessels,
trains, airplanes, barges etc.""" ;
  rdfs:label "Transport Means" ;
  rdfs:subClassOf :LogisticsObject ;
.
:Truck
  a owl:Class ;
  rdfs:comment "A truck or lorry is a motor vehicle designed to transport cargo. Trucks vary greatly in size, power, and configuration." ;
  rdfs:label "Truck" ;
  rdfs:subClassOf :TransportMeans ;
.
:ULD
  a owl:Class ;
  rdfs:comment "(Air Freight Specific) Unit Load Devices are light weight containers for air transport and facilitate loading cargo into aircraft." ;
  rdfs:label "Unit Load Devices" ;
  rdfs:subClassOf :Container ;
.
:Vessel
  a owl:Class ;
  rdfs:comment "Any transport means used for transporting cargo by sea/ocean. Watercraft, also known as water vessels or waterborne vessels, are vehicles used in water, including boats, ships, hovercraft and submarines. Watercraft usually have a propulsive capability (whether by sail, oar, paddle or engine) and hence are distinct from a simple device that merely floats, such as a log raft." ;
  rdfs:label "Vessel" ;
  rdfs:subClassOf :TransportMeans ;
.
# ------------ UN PACKAGING CLASSIFICATION BASED ON PHYSICAL FORM ------------ 
:Drum
  a owl:Class ;
  rdfs:comment "A cylindrical container with flat ends used for liquids, powders or granular goods, including barrels and casks of various materials. Rec 21 codes: BA, DR, DI, IH, FI, HG, BU, TO, TI, QA–QJ." ;
  rdfs:label "Drum" ;
  rdfs:subClassOf :BulkEquipment ;
  rdfs:subClassOf :LiquidEquipment ;
.

:Jerrican
  a owl:Class ;
  rdfs:comment "A rectangular or cylindrical container fitted with a handle, used mainly for liquids. Rec 21 codes: JC, JY, QK–QN." ;
  rdfs:label "Jerrican" ;
  rdfs:subClassOf :LiquidEquipment ;
.

:Bottle
  a owl:Class ;
  rdfs:comment "A narrow-necked receptacle, typically glass or plastic, for liquids or gases; includes protected, bulbous and gas bottles. Rec 21 codes: BO, BQ, BS, BV, GB, FL, DJ, DP, VI, WB, CO, CP." ;
  rdfs:label "Bottle" ;
  rdfs:subClassOf :LiquidEquipment ;
  rdfs:subClassOf :GasEquipment ;
.

:Box
  a owl:Class ;
  rdfs:comment "A rigid rectangular container of wood, plastic, metal or fibreboard, including cartons and cases. Rec 21 codes: BX, CS, CT, BW, TC, FO, SS, SK, ED–EI, QP–QS." ;
  rdfs:label "Box" ;
  rdfs:subClassOf :LiquidEquipment ;
  rdfs:subClassOf :PiecesEquipment ;
.

:Crate
  a owl:Class ;
  rdfs:comment "An open or slatted framed container of wood, plastic or metal used for grouping goods. Rec 21 codes: CR, SC, FC, FD, MA, BC, DA–DC, DK–DM." ;
  rdfs:label "Crate" ;
  rdfs:subClassOf :PiecesEquipment ;
  rdfs:subClassOf :BulkEquipment ;
.

:Bag
  a owl:Class ;
  rdfs:comment "A flexible container of paper, plastic, textile or woven material for solids or powders. Rec 21 codes: BG, SA, GY, JT, MB, MS, PO, TT, JB, ZB, FX, EC, XA–XK." ;
  rdfs:label "Bag" ;
  rdfs:subClassOf :PiecesEquipment ;
  rdfs:subClassOf :BulkEquipment ;
.

:Basket
  a owl:Class ;
  rdfs:comment "An open container, often with a handle, made of wickerwork, plastic or cardboard. Rec 21 codes: BK, HA–HC, HR, PJ, CE." ;
  rdfs:label "Basket" ;
  rdfs:subClassOf :PiecesEquipment ;
.

:Tray
  a owl:Class ;
  rdfs:comment "A shallow flat container, with or without cover, for horizontally stacked or layered goods. Rec 21 codes: PU, DS–DY, GU, IL." ;
  rdfs:label "Tray" ;
  rdfs:subClassOf :PiecesEquipment ;
.

:Can
  a owl:Class ;
  rdfs:comment "A metal container, rectangular or cylindrical, for liquids or solids, including tins and canisters. Rec 21 codes: CA, CX, CD, TN, CI." ;
  rdfs:label "Can" ;
  rdfs:subClassOf :PiecesEquipment ;
  rdfs:subClassOf :LiquidEquipment ;
.

:Pail
  a owl:Class ;
  rdfs:comment "An open-top vessel such as a pail, bucket, tub, pot or vat, usually fitted with a handle. Rec 21 codes: BJ, PL, TB, TL, VA, PT, BM, CU." ;
  rdfs:label "Pail" ;
  rdfs:subClassOf :BulkEquipment ;
  rdfs:subClassOf :LiquidEquipment ;
.

:PressureReceptacle
  a owl:Class ;
  rdfs:comment "A receptacle designed to hold gases or contents under pressure, including cylinders and aerosols. Rec 21 codes: CY, GB, AE, VG, VQ." ;
  rdfs:label "Pressure Receptacle" ;
  rdfs:subClassOf :GasEquipment ;
.

:Tank
  a owl:Class ;
  rdfs:comment "A large rigid or flexible receptacle for the bulk carriage of liquids or gases. Rec 21 codes: TG, TK, TY, FE, FB." ;
  rdfs:label "Tank" ;
  rdfs:subClassOf :GasEquipment ;
  rdfs:subClassOf :LiquidEquipment ;
  rdfs:subClassOf :BulkEquipment ;
.

:Container
  a owl:Class ;
  rdfs:comment "A reusable freight article for the unitised carriage of goods, not otherwise specified as transport equipment. Rec 21 codes: CN, ME, GL, VK, LV." ;
  rdfs:label "Container" ;
  rdfs:subClassOf :PiecesEquipment ;
  rdfs:subClassOf :BulkEquipment ;
.

:IntermediateBulkContainer
  a owl:Class ;
  rdfs:comment "A rigid, flexible or composite container for the intermediate bulk carriage of solids or liquids. Rec 21 codes: WA, WC–WZ, ZA, ZC–ZY." ;
  rdfs:label "Intermediate Bulk Container" ;
  rdfs:subClassOf :GasEquipment ;
  rdfs:subClassOf :LiquidEquipment ;
  rdfs:subClassOf :BulkEquipment ;
.

:CompositePackaging
  a owl:Class ;
  rdfs:comment "An inner receptacle held within an outer packaging of a different material, functioning as a single unit. Rec 21 codes: YA–YZ." ;
  rdfs:label "Composite Packaging" ;
  rdfs:subClassOf :LiquidEquipment ;
  rdfs:subClassOf :BulkEquipment ;
.

:Reel
  a owl:Class ;
  rdfs:comment "A cylindrical core on or around which flexible material is wound, including spools, coils, rolls and bobbins. Rec 21 codes: RL, SO, BB, CL, RO, SD." ;
  rdfs:label "Reel" ;
  rdfs:subClassOf :PiecesEquipment ;
.

:Pallet
  a owl:Class ;
  rdfs:comment "A flat load-bearing platform for unitising and handling goods, including modular, box and standardised pallets, skids and slipsheets. Rec 21 codes: PX, OA–OF, PB, PD, PE, TW, SI, SL." ;
  rdfs:label "Pallet" ;
  rdfs:subClassOf :PiecesEquipment ;
.

:Bundle
  a owl:Class ;
  rdfs:comment "Bare elongated goods bound together for handling, such as bars, rods, pipes, planks, ingots and sheets. Rec 21 codes: BR, RD, PI, PN, PG, IN, GI, LG, BD, SB, SM, ST, BY, BZ, GZ, IZ, LZ, PV, PY, RZ, SZ, TZ." ;
  rdfs:label "Bundle" ;
  rdfs:subClassOf :PiecesEquipment ;
.

:Wrapping
  a owl:Class ;
  rdfs:comment "A flexible covering or enclosure that wraps or encloses goods, including envelopes, sleeves, nets, films and shrink-wrap. Rec 21 codes: EN, SV, SW, SP, SY, VP, CV, CZ, MT, NT, NU, NV, RT." ;
  rdfs:label "Wrapping" ;
  rdfs:subClassOf :PiecesEquipment ;
.

:Rack
  a owl:Class ;
  rdfs:comment "An open framework structure for holding or hanging goods, including cages and clothing-hanger racks. Rec 21 codes: RK, RJ, CG, CW, DG, HN." ;
  rdfs:label "Rack" ;
  rdfs:subClassOf :PiecesEquipment ;
.
# ------------ PROPERTIES ------------ 
:UUID
  a owl:DatatypeProperty ;
  rdfs:comment "" ;
  rdfs:label "UUID" ;
  rdfs:domain :LogisticsObject ;
  rdfs:range xsd:string ;
  skos:altLabel "IMO0140"
.
:ExternalIdentifier
  a owl:Class ;
  rdfs:label "External Identifier" ;
  rdfs:comment "Identifier external of the data sharing system - can be HS / CN code"
.
:externalIdentifierValue
  a owl:ObjectProperty ;
  rdfs:comment "" ;
  rdfs:label "External Identifier value" ;
  rdfs:domain :ExternalIdentifier ;
  rdfs:range xsd:string
.
:externalIdentifierDescription
  a owl:ObjectProperty ;
  rdfs:comment "" ;
  rdfs:label "External Identifier description" ;
  rdfs:domain :ExternalIdentifier ;
  rdfs:range xsd:string
.
:name
  a owl:DatatypeProperty ;
  rdfs:comment "" ;
  rdfs:domain :LogisticsObject ;
  rdfs:range xsd:string
.
:country
  a owl:DatatypeProperty ;
  rdfs:comment "" ;
  rdfs:domain :LogisticsObject ;
  rdfs:range xsd:string
.
:flightNumber
  a owl:DatatypeProperty ;
  rdfs:comment "" ;
  rdfs:label "Flight number" ;
  rdfs:domain :Airplane ;
  rdfs:range xsd:string ;
.
:LogisticsObjectMaxSize
  a owl:DatatypeProperty ;
  rdfs:domain :LogisticsObject ;
  rdfs:label "Cargo Maximum Size" ;
  rdfs:range xsd:integer ;
.
:LogisticsObjectMaximumTemperature
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Cargo Maximum Temperature" ;
  rdfs:range xsd:string ;
.
:LogisticsObjectMaximumVolume
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Cargo Maximum Volume" ;
  rdfs:range xsd:integer ;
.
:LogisticsObjectMinimumSize
  a owl:DatatypeProperty ;
  rdfs:domain :LogisticsObject ;
  rdfs:label "Cargo Minimum Size" ;
  rdfs:range xsd:integer ;
.
:LogisticsObjectMinimumTemperature
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Cargo Minimum Temperature" ;
  rdfs:range xsd:string ;
.
:LogisticsObjectMinimumVolume
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Cargo Minimum Volume" ;
  rdfs:range xsd:integer ;
.
:LogisticsObjectTemperature
  a owl:DatatypeProperty ;
  rdfs:label "Cargo Temperature" ;
  rdfs:range xsd:string ;
  rdfs:domain :LogisticsObject ;
.
:connectedToSealingParty
  a owl:ObjectProperty ;
  rdfs:comment "This property relates the seal with the sealing party involved (instantiated as legal person)." ;
  rdfs:domain :Seal ;
  rdfs:label "connected to sealing party" ;
  rdfs:range LegalPerson:LegalPerson ;
.
:containerNumber
  a owl:DatatypeProperty ;
  rdfs:comment "Container number" ;
  rdfs:domain :Container ;
  rdfs:label "Container Number" ;
  rdfs:range xsd:string ;
.
:containerSize
  a owl:DatatypeProperty ;
  rdfs:label "Cargo Container Size" ;
  rdfs:range xsd:integer ;
  rdfs:domain :Container
.
:containerType
  a owl:DatatypeProperty ;
  rdfs:domain :Container ;
  rdfs:label "Container Type" ; # TODO There are standards for container type codes. Let's pick one and explain.
  rdfs:range xsd:string ;
.
:damageRemarks
  a owl:DatatypeProperty ;
  rdfs:domain :LogisticsObject ;
  rdfs:label "Damage Remarks" ;
  rdfs:range xsd:string ;
.
:dangerousGoodsRegulationCode
  a owl:DatatypeProperty ;
  rdfs:comment "Dangerous goods require a dangerous goods regulation code. The code consists of 3 characters." ;
  rdfs:domain :Goods ;
  rdfs:label "Dangerous Goods Regulation Code" ;
  rdfs:range xsd:string ;
.
:documentID
  a owl:DatatypeProperty ;
  rdfs:domain :Document ;
  rdfs:range xsd:string ;
.
:documentVersion
  a owl:DatatypeProperty ;
  rdfs:domain :Document ;
  rdfs:range xsd:string ;
.
:equipmentCategoryCode
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Equipment Container Type" ;
.
:equipmentContainerITUCode
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Equipment Container ITU Code" ;
.
:equipmentProperties
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
.
:equipmentTypeCode
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Equipment Type Code" ; # TODO Choose a standard, and explain. Codelist, or reference to other standard.
  rdfs:range xsd:string ;
.
:goodsDescription
  a owl:DatatypeProperty ;
  rdfs:domain :Goods ;
  rdfs:label "Goods Description" ;
  rdfs:range xsd:string ;
.
:goodsTypeCode
  a owl:DatatypeProperty ;
  rdfs:domain :Goods ;
  rdfs:label "Goods Type Code" ;
  rdfs:range xsd:string
.
:WeightMeasurement
  a owl:Class ;
  rdfs:label "Weight Measurement" ;
  rdfs:comment "Measured weight of logistics object, alongside description of gross/net and unit of measure used"
.
:weightValue
  a owl:DatatypeProperty ;
  rdfs:domain :WeightMeasurement ;
  rdfs:label "Weight Numerical Value" ;
  rdfs:range xsd:float ;
.
:weightUnitOfMeasure
  a owl:DatatypeProperty ;
  rdfs:domain :WeightMeasurement ;
  rdfs:label "Weight Numerical Value" ;
  rdfs:range xsd:string ; # TODO: to be assessed against pilot findings if a separate, explicit unit of measure pointing to an uOM ontology property needs to be introduced or this one is transformed 
.
:weightDescription
  a owl:DatatypeProperty ;
  rdfs:domain :WeightMeasurement ;
  rdfs:label "Weight Description" ;
  rdfs:comment "Weight Description as either gross or net" ;
  rdfs:range xsd:string ;
.
:harmonizedSystemCode
  a owl:DatatypeProperty ;
  rdfs:domain :LogisticsObject ;
  rdfs:label "Harmonized System Code" ;
  rdfs:comment "Standardized code to categorize products, used by customs authorities" ;
  rdfs:range xsd:string ;
.
:UNDGCode
  a owl:DatatypeProperty ;
  rdfs:comment "Goods can be assigned a UNDG code to identify the hazardous nature of the goods." ;
  rdfs:domain :Goods ;
  rdfs:label "UNDG code" ;
  rdfs:range xsd:string ;
.
:hasDocumentType
  a owl:DatatypeProperty ;
  rdfs:domain :Document ;
  rdfs:label "has Document Type" ;
  rdfs:range xsd:string ;
.
:hasFlashpointTemperature
  a owl:DatatypeProperty ;
  rdfs:comment "This property relates a physical object with its flashpoint temperature given as a measure from Unit of Measure (OUM) ontology" ;
  rdfs:domain :LogisticsObject ;
  rdfs:label "Flashpoint temperature" ;
  rdfs:range xsd:string
.
:hasMRN_Number
  a owl:DatatypeProperty ;
  rdfs:label "MRN Number" ;
  rdfs:domain :Document ;
  rdfs:range xsd:string ;
.
:hasNumberOfCollies
  a owl:DatatypeProperty ;
  rdfs:label "Number of Collies" ;
  rdfs:domain :PiecesGoods ;
  rdfs:range xsd:integer ;
.
:hasSeal
  a owl:ObjectProperty ;
  rdfs:comment "A goods/equipment involves seal" ;
  rdfs:domain :Goods ;
  rdfs:domain :Equipment ;
  rdfs:label "Involved Seal"
.
:hasSealConditionCode
  a owl:DatatypeProperty ;
  rdfs:comment "A code specifying a condition of this logistics seal." ;
  rdfs:domain :Seal ;
  rdfs:label "Has Seal Condition Code" ;
  rdfs:range xsd:string
.
:transportMeansMode
  a owl:DatatypeProperty ;
  rdfs:comment "A code specifying the transport means mode." ;
  rdfs:domain :TransportMeans ;
  rdfs:label "Transport Means Mode" ;
  rdfs:range xsd:string ;
  skos:altLabel "IMO0160"
.
:hasTransportmeansNationality
  a owl:DatatypeProperty ;
  rdfs:domain :TransportMeans ;
  rdfs:label "Transport Means Nationality" ;
  rdfs:range xsd:string ;
  rdfs:subPropertyOf :transportMeansProperties ;
.
:hasVolume
  a owl:ClassProperty ;
  rdfs:domain :Goods ;
  rdfs:domain :Equipment ;
  rdfs:range :VolumeMeasurement ;
  rdfs:label "Volume" ;
.
:hasWeight
  a owl:ClassProperty ;
  rdfs:domain :LogisticsObject ;
  rdfs:range :WeightMeasurement ;
  rdfs:label "Weight"
.
:hazardousMaterialDetail
  a owl:DatatypeProperty ;
  rdfs:domain :LogisticsObject ;
  rdfs:range xsd:string
.
:isEmpty
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Is Empty" ;
  rdfs:range xsd:boolean ;
.
:isFull
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Is Full" ;
  rdfs:range xsd:boolean ;
.
:involvesGoods
  a owl:ObjectProperty ;
  rdfs:domain :Equipment ;
  rdfs:range :Goods ;
  rdfs:label "Involves goods" ;
  rdfs:comment "An equipment is associated to goods based on the type of goods that can be held by the equipment, and the type of the goods."
.
:licensePlate
  a owl:DatatypeProperty ;
  rdfs:domain :Truck ;
  rdfs:domain :Trailer ;
  rdfs:label "License Plate" ;
  rdfs:range xsd:string ;
  rdfs:subPropertyOf :transportMeansPropertiesExternalIdentification
.
:loadCapacity
  a owl:DatatypeProperty ;
  rdfs:domain :Equipment ;
  rdfs:label "Load Capacity" ;
  rdfs:range xsd:integer ;
.
:locomotiveBrakeType
  a owl:DatatypeProperty ;
  rdfs:domain :Locomotive ;
  rdfs:label "Locomotive Brake Type" ;
