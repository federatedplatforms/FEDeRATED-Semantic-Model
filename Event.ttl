# baseURI: https://ontology.tno.nl/logistics/federated/Event
# imports: https://ontology.tno.nl/logistics/federated/DigitalTwin
# imports: https://ontology.tno.nl/logistics/federated/LegalPerson
# imports: https://ontology.tno.nl/logistics/federated/Location
# prefix: Event

@prefix : <https://ontology.tno.nl/logistics/federated/Event#> .
@prefix DigitalTwin: <https://ontology.tno.nl/logistics/federated/DigitalTwin#> .
@prefix LegalPerson: <https://ontology.tno.nl/logistics/federated/LegalPerson#> .
@prefix Location: <https://ontology.tno.nl/logistics/federated/Location#> .

@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.tno.nl/logistics/federated/Event>
  a owl:Ontology ;
  dc:creator "Dena Tahvildari, Maaike Burghoorn, Cornelis Bouter, Theodor Chirvasuta" ;
  dcterms:created "2020-07-17"^^xsd:date ;
  dcterms:description "This ontology contains classes, attributes, relation about logistic Events." ;
  dcterms:issued "2021-03-15"^^xsd:date ;
  dcterms:modified "2023-07-18"^^xsd:date ;
  dcterms:language "en" ;
  owl:imports <https://ontology.tno.nl/logistics/federated/DigitalTwin> ;
  owl:imports <https://ontology.tno.nl/logistics/federated/LegalPerson> ;
  owl:imports <https://ontology.tno.nl/logistics/federated/Location> ;
  owl:versionIRI <https://ontology.tno.nl/logistics/federated/Event/v0.1.0/> ;
  owl:versionInfo "v0.1.0" ;
  rdfs:seeAlso <https://github.com/federatedplatforms/FEDeRATED-Semantic-Model> ;
.

# High level Event classes

:Event
  a owl:Class ;
  rdfs:comment "An event reflects a conceptual association of digital twins or a virtualization of a physical event" ;
  rdfs:label "Event" ;
.
:BusinessIdentifier
  a owl:Class ;
  rdfs:comment "A Business Identifier enables consistent traceability and linkage between operational events, actors, assets, and related business information. It is made of two elements - the business identifier alphanumeric value, and its description" ;
  rdfs:label "BusinessIdentifier"
.

# Unique identifier for storage of event

:UUID a owl:DatatypeProperty ;
  rdfs:comment "Every event has a UUID to be distinguishable when stored in a database." ;
  rdfs:label "UUID" ;
  rdfs:domain :Event ;
  rdfs:range xsd:string
.

# Timestamp

:involvesTimestamp
  a owl:DatatypeProperty ;
  rdfs:comment "The timestamp expressed as a date and time, alongside the timezone it is specified";
  rdfs:label "Involves Timestamp";
  rdfs:range :Timestamp ;
  rdfs:subPropertyOf :involves ;
  rdfs:domain :Event 
.

:Timestamp
  a owl:Class ;
  rdfs:comment "Class used to aggregate the datetime timestamp and the classification of the timestamp" ;
  rdfs:label "Timestamp" ;
.

:involvesTimeClassification a owl:DatatypeProperty ;
  rdfs:comment "Every timestamp should have a time classification. The time classifications may be planned, estimated, expected, actual, requested, or other denominations." ;
  rdfs:label "Involves Time Classification" ;
  rdfs:domain :Timestamp ;
  rdfs:range xsd:string ;
.

:involvesTimestampDateTime a owl:DatatypeProperty ;
  rdfs:comment "Every timestamp must have the date time specified." ;
  rdfs:label "Involves DateTime" ;
  rdfs:domain :Timestamp ;
  rdfs:range xsd:dateTime ;
.

# Involves predicates

:involves
  a owl:ObjectProperty ;
  rdfs:comment "An Event has associations established with Digital Twins, Locations or Logistic Actors. The meaning of this association depends on the type of event and its milestone." ;
  rdfs:domain :Event ;
  rdfs:label "Involves" ;
  rdfs:range owl:Thing ;
.
:involvesBusinessIdentifier
  a owl:DatatypeProperty ;
  rdfs:comment "Identifier that can be used to refer to an external system the business transaction where the event is involved in (e.g., AWB / eFTI / voyage number (IMO0191))" ;
  rdfs:domain :Event ;
  rdfs:label "Involves Business Identifier" ;
  rdfs:range :BusinessIdentifier ;
.
:involvesAlphanumericBusinessIdentifier
  a owl:DatatypeProperty ;
  rdfs:comment "Alphanumeric value of the business identifier" ;
  rdfs:domain :BusinessIdentifier ;
  rdfs:label "Business Identifier value" ;
  rdfs:range xsd:string ;
.
:involvesDescriptionBusinessIdentifier
  a owl:DatatypeProperty ;
  rdfs:comment "Description of the business identifier" ;
  rdfs:domain :BusinessIdentifier ;
  rdfs:label "Business Identifier description" ;
  rdfs:range xsd:string ;
.
:involvesDigitalTwin
  a owl:ObjectProperty ;
  rdfs:label "Involves Digital Twin" ;
  rdfs:comment "Used for grouping -- do not instantiate" ;
  rdfs:domain :Event ;
  rdfs:range DigitalTwin:PhysicalObject ;
  rdfs:subPropertyOf :involves ;
.
:involvesEvent
  a owl:ObjectProperty ;
  rdfs:label "Involves Event" ;
  rdfs:comment "Used for referencing track & trace events (ETA, ATA, ETD, ATD, etc)" ;
  rdfs:domain :Event ;
  rdfs:range :Event ;
  rdfs:subPropertyOf :involves ;
.
:involvesLocation
  a owl:ObjectProperty ;
  rdfs:comment "This relation establishes an association between an Event and a Location. The exact meaning depends on the type of Event, which is inferred from this property and the second association the event has." ;
  rdfs:domain :Event ;
  rdfs:label "Involves Location" ;
  rdfs:range Location:BusinessLocation ;
.
:involvesActor
  a owl:ObjectProperty ;
  rdfs:label "Involves Actor" ;
  rdfs:comment "This relation establishes an association between an Event and an Actor." ;
  rdfs:domain :Event ;
  rdfs:range LegalPerson:Actor ;
  rdfs:subPropertyOf :involves ;
.
:involvesPackagingType
  a owl:DatatypeProperty ;
  rdfs:label "Involves Packaging Type" ;
  rdfs:comment "This property denotes the packaging involved in the association of the product/goods with a package." ;
  rdfs:domain :CargoAssociation ; # TODO this class is not defined.
  rdfs:range xsd:string ;
  skos:altLabel "IMO0029"
.

:involvesTransportMeans
  a owl:ObjectProperty ;
  rdfs:comment "This relation establishes an association between an Event and a Transport Means Digital Twin. The exact meaning depends on the type of Event and its milestone" ;
  rdfs:domain :Event ;
  rdfs:label "Involves Transport Means" ;
  rdfs:range DigitalTwin:TransportMeans ;
  rdfs:subPropertyOf :involvesDigitalTwin ;
.