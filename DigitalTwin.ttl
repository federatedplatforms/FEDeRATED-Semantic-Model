# ------------ CLASSIFICATIONS ------------ 
:Ferry
  a :Vessel ;
  rdfs:comment "Used for transport of other transport means like trucks and/or trailers."@en;
  rdfs:label "Ferry"@en;
.
:DanishContainer
  a :Container ;
  rdfs:comment "A Danish container for the transportation of e.g. flowers."@en;
  rdfs:label "Danish Container"@en.
:DeepSeaBulkVessel
  a :Vessel ;
  rdfs:label "Deep Sea Bulk Vessel"@en.
:DeepSeaContainerVessel
  a :Vessel ;
  rdfs:label "Deep Sea Container Vessel"@en.
:DeepSeaVessel
  a :Vessel ;
  rdfs:comment "Used for ocean transport."@en;
  rdfs:label "Deep Sea Vessel"@en.
